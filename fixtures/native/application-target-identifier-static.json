  "recoveredSource": [
    "static func identifier(for bundleURL: URL) -> String {",
    "  var value = bundleURL.resolvingSymlinksInPath()",
    "    .standardizedFileURL",
    "    .path(percentEncoded: false)",
    "  while value.count > 1 && value.hasSuffix(\"/\") {",
    "    value.remove(at: value.index(before: value.endIndex))",
    "  }",
    "  return value",
    "}"
  ],
